---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content.js';

const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  foundingDate: '2017',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed,
  knowsAbout: [
    'Due diligence técnica de edificios',
    'Rehabilitación de edificios catalogados',
    'Cambio de uso a vivienda',
    'Licencias de obra y actividad en Barcelona',
    'Interiorismo',
    'Dirección de obra',
  ],
  sameAs: [`https://www.google.com/maps/place/?q=place_id:${site.placeId}`],
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_ES" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --ink: #202124; --sage: #a3a28e; --bone: #eaeae4; --stone: #dcdbd2;
    --muted: #5c5b50; --text2: #3d3e40; --card: #f3f3ee; --line: rgba(32,33,36,.15);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bone); color: var(--ink); font: 400 17px/1.5 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { text-wrap: balance; font-weight: 500; margin: 0; }
  p { margin: 0; }
  .wrap { max-width: 1280px; margin: 0 auto; padding-left: max(24px, 4vw); padding-right: max(24px, 4vw); }
  .lbl { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: var(--ink); color: var(--bone); text-decoration: none; font-weight: 500; }
  .btn--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .btn--light { background: var(--bone); color: var(--ink); }
  .ph { background: #c9c8bb; object-fit: cover; width: 100%; }
  .h2 { font-size: clamp(32px, 3.4vw, 48px); line-height: 1.08; }
  .dark { background: var(--ink); color: var(--bone); }
  .dark .lbl { color: var(--sage); }
  .stone { background: var(--stone); }
</style>
