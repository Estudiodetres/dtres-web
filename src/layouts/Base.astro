---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, team as esTeam, reviews as esReviews } from '../data/content.js';
import { htmlLang, ogLocale, langs } from '../i18n/index.js';
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';

const { title, description, jsonLd = [], lang = 'es', alternates = null, noindex = false } = Astro.props;
const waText = { es: 'Hola Nacho, tengo un edificio y me gustaría saber si podéis ayudarme.', ca: "Hola Nacho, tinc un edifici i m'agradaria saber si em podeu ajudar.", en: 'Hi Nacho, I have a building and would like to know if you can help.' };
const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(waText[lang] || waText.es)}`;
const waLabel = { es: 'Escríbenos por WhatsApp', ca: 'Escriu-nos per WhatsApp', en: 'Message us on WhatsApp' }[lang] || 'WhatsApp';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p) => new URL(p, Astro.site).href;
// Imagen para compartir: usa la URL real del despliegue (Netlify) para que funcione antes de apuntar el dominio
const ogBase = process.env.URL || Astro.site;
const ogImage = new URL('/img/og.jpg?v=2', ogBase).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  foundingDate: '2017',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed,
  knowsAbout: [
    'Due diligence técnica de edificios',
    'Rehabilitación de edificios catalogados',
    'Cambio de uso a vivienda',
    'Licencias de obra y actividad en Barcelona',
    'Interiorismo',
    'Dirección de obra',
    'Cambio de uso de edificios',
    'Transformación de activos inmobiliarios',
    'Licencias de obra por fases',
  ],
  slogan: 'Transformamos edificios para darles un nuevo uso.',
  description: 'Estudio de arquitectura e interiorismo en Barcelona especializado en transformar edificios para un nuevo uso: due diligence técnica, cambio de uso, rehabilitación de edificios catalogados, licencias, interiorismo y dirección de obra.',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 12 },
  audience: ['Inversores y fondos inmobiliarios', 'Fundaciones e instituciones', 'Propietarios y family offices', 'Empresas'].map((a) => ({ '@type': 'BusinessAudience', audienceType: a })),
  founder: esTeam.partners.filter((p) => /cofundador/.test(p.role)).map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.title, description: `${p.role}. ${p.note}`, sameAs: p.linkedin ? [p.linkedin] : undefined })),
  employee: esTeam.partners.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.title, worksFor: { '@id': `${site.url}/#org` }, affiliation: { '@type': 'CollegeOrUniversity', name: 'Escuela de Arquitectura UIC Barcelona' }, sameAs: p.linkedin ? [p.linkedin] : undefined })),
  review: esReviews.map((r) => ({ '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 }, author: { '@type': 'Person', name: r.author }, reviewBody: r.quote, publisher: { '@type': 'Organization', name: 'Google' } })),
  sameAs: [`https://www.google.com/maps/place/?q=place_id:${site.placeId}`, ...(site.social || [])],
};
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alternates
    ? [...langs.filter((l) => alternates[l]).map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />),
       <link rel="alternate" hreflang="x-default" href={abs(alternates.es ?? alternates[lang])} />]
    : <link rel="alternate" hreflang={lang} href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale[lang]} />
  <meta property="og:site_name" content="DTRES" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="DTRES · Tu edificio puede valer mucho más" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
</head>
<body>
  <Header lang={lang} alternates={alternates} />
  <main><slot /></main>
  <Footer lang={lang} />
  <a class="wa" href={waUrl} target="_blank" rel="noopener" aria-label={waLabel}>
    <svg viewBox="0 0 32 32" aria-hidden="true"><path class="wa__b" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3z"/><path class="wa__p" d="M11.5 10.5c.4-.8 1.2-.8 1.5-.1l1.2 2.6c.2.4 0 .9-.3 1.2l-.8.8c.9 1.9 2.4 3.4 4.3 4.3l.8-.8c.3-.3.8-.5 1.2-.3l2.6 1.2c.7.3.7 1.1-.1 1.5-1.2.7-2.6.9-3.9.4-3.4-1.3-6-3.9-7.3-7.3-.5-1.3-.3-2.7.4-3.9z"/></svg>
    <span>WhatsApp</span>
  </a>
  <style is:global>
    .wa { position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 50; display: inline-flex; align-items: center; gap: 10px; background: #25d366; color: #fff; padding: 12px 18px 12px 14px; text-decoration: none; font-size: 15px; font-weight: 500; box-shadow: 0 6px 20px rgba(0,0,0,.18); }
    .wa:hover { background: #1ebe5b; color: #fff; }
    .wa svg { width: 24px; height: 24px; stroke-linejoin: round; } .wa__b { fill: none; stroke: currentColor; stroke-width: 2.2; } .wa__p { fill: currentColor; stroke: none; }
    .wa { padding: 15px; border-radius: 50%; } .wa span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .wa svg { width: 28px; height: 28px; }
  </style>
</body>
</html>

<style is:global>
  :root {
    --ink: #202124; --sage: #a3a28e; --bone: #eaeae4; --stone: #dcdbd2;
    --muted: #5c5b50; --text2: #3d3e40; --card: #f3f3ee; --line: rgba(32,33,36,.15);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; overscroll-behavior-y: none; background: linear-gradient(var(--bone) 50%, var(--ink) 50%); }
  body { margin: 0; overscroll-behavior-y: none; background: var(--bone); color: var(--ink); font: 400 17px/1.5 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif; }
  img { max-width: 100%; display: block; }
  [hidden] { display: none !important; }
  @media (max-width: 520px) { .cf button { align-self: stretch; justify-content: center; } }
  a { color: inherit; }
  h1, h2, h3 { text-wrap: balance; font-weight: 500; margin: 0; overflow-wrap: break-word; }
  p { margin: 0; }
  .wrap { max-width: 1280px; margin: 0 auto; padding-left: max(24px, 4vw); padding-right: max(24px, 4vw); }
  @media (min-width: 1680px) { .wrap { max-width: 1520px; } }
  .lbl { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: var(--ink); color: var(--bone); text-decoration: none; font-weight: 500; }
  .btn--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .btn--light { background: var(--bone); color: var(--ink); }
  .ph { background: #c9c8bb; object-fit: cover; width: 100%; height: auto; }
  .h2 { font-size: clamp(32px, 3.4vw, 48px); line-height: 1.08; }
  .dark { background: var(--ink); color: var(--bone); }
  .dark .lbl { color: var(--sage); }
  .stone { background: var(--stone); }
</style>
