---
import Base from '../../layouts/Base.astro';
import { ui, routes } from '../../i18n/index.js';
import { site } from '../../data/content.js';
const lang = 'ca';
const t = ui[lang].thanks;
---
<Base title={`${t.eyebrow} · DTRES`} description={t.title} lang={lang} alternates={routes.thanks} noindex>
  <section class="wrap" style="padding-block:140px;display:flex;flex-direction:column;gap:24px;align-items:flex-start">
    <p class="lbl">{t.eyebrow}</p>
    <h1 style="font-size:clamp(40px,6vw,80px);line-height:1;max-width:18ch">{t.title}</h1>
    <p style="font-size:19px;max-width:44ch">{t.text} <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" style="color:var(--ink);font-weight:500;text-underline-offset:4px">{t.wa}</a></p>
    <a class="btn" href={routes.home[lang]}>{t.back}</a>
  </section>
</Base>
