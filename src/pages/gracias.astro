---
import Base from '../layouts/Base.astro';
---
<Base title="Gracias · DTRES" description="Hemos recibido tu mensaje.">
  <section class="wrap" style="padding-block:140px;display:flex;flex-direction:column;gap:24px;align-items:flex-start">
    <p class="lbl">Mensaje recibido</p>
    <h1 style="font-size:clamp(40px,6vw,80px);line-height:1">Gracias. Te llamamos en menos de 48 horas.</h1>
    <p style="font-size:19px;max-width:44ch">Si es urgente, escríbenos a info@detres.eu o llámanos al 931 255 444.</p>
    <a class="btn" href="/">Volver al inicio</a>
  </section>
</Base>
