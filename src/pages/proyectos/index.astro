---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { allProjects, site } from '../../data/content.js';

const fmt = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const filters = [
  ['todos', 'Todos'], ['patrimonio', 'Patrimonio catalogado'], ['residencias', 'Residencias'],
  ['oficinas', 'Oficinas'], ['equipamientos', 'Equipamientos'], ['curso', 'En curso'],
];
const total = allProjects.reduce((a, p) => a + p.m2, 0);
const listLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Proyectos de DTRES',
  itemListElement: allProjects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.use} · ${p.client} · ${fmt(p.m2)} m²` })),
};
---
<Base
  title="Proyectos · Transformación de edificios en Barcelona · DTRES"
  description={`Edificios catalogados, residencias, oficinas y equipamientos transformados en Barcelona y Catalunya. ${allProjects.length} proyectos, más de ${fmt(Math.floor(total / 1000) * 1000)} m².`}
  jsonLd={[listLd]}
>
  <section class="wrap pj-hero">
    <p class="lbl">Proyectos · Barcelona y Catalunya</p>
    <h1>Edificios que han cambiado de vida.</h1>
    <p class="pj-hero__sub">Patrimonio catalogado, residencias, oficinas y equipamientos para fundaciones, inversores y empresas. De la due diligence a la entrega de llaves.</p>
  </section>

  <section class="wrap pj">
    <div class="pj__filters" role="group" aria-label="Filtrar proyectos">
      {filters.map(([k, l], i) => <button type="button" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
    </div>
    <div class="pj__grid">
      {allProjects.map((p) => (
        <article data-cat={p.cat} data-heritage={p.heritage ? '1' : '0'} data-curso={p.status ? '1' : '0'} class={p.img ? '' : 'noimg'}>
          {p.img
            ? <img class="ph" src={p.img} alt={`${p.use} · ${p.client}`} width="600" height="750" loading="lazy" />
            : <div class="pj__ph"><span>{p.status ?? 'Proyecto'}</span><strong>{fmt(p.m2)} m²</strong></div>}
          <span class="lbl">{[p.status, p.heritage && 'Patrimonio catalogado', `${fmt(p.m2)} m²`].filter(Boolean).join(' · ')}</span>
          <h2>{p.use}</h2>
          <p>{p.client}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contacto" class="dark">
    <div class="wrap pj-cta">
      <h2>¿Tienes un edificio que merece otra vida?</h2>
      <ContactForm origen="proyectos" />
    </div>
  </section>
</Base>
<script>
  const btns = document.querySelectorAll('.pj__filters button');
  const items = document.querySelectorAll('.pj__grid article');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((it) => {
      const show = f === 'todos' || (f === 'curso' ? it.dataset.curso === '1' : f === 'patrimonio' ? it.dataset.heritage === '1' : it.dataset.cat === f);
      it.hidden = !show;
    });
  }));
</script>
<style>
  .pj-hero { padding-block: 96px 56px; display: flex; flex-direction: column; gap: 24px; }
  .pj-hero h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 16ch; text-wrap: balance; }
  .pj-hero__sub { font-size: 21px; line-height: 1.45; max-width: 52ch; }
  .pj { padding-block: 0 120px; display: flex; flex-direction: column; gap: 40px; }
  .pj__filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .pj__filters button { font: inherit; font-size: 14px; padding: 10px 16px; border: 1px solid var(--line); background: transparent; color: inherit; cursor: pointer; }
  .pj__filters button[aria-pressed="true"] { background: #202124; color: #eaeae4; border-color: #202124; }
  .pj__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px 24px; }
  @media (max-width: 860px) { .pj__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .pj__grid { grid-template-columns: 1fr; } }
  .pj__grid article { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .pj__grid img, .pj__ph { aspect-ratio: 4 / 5; width: 100%; }
  .pj__ph { background: #dcdbd2; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; }
  .pj__ph span { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #6b6b60; }
  .pj__ph strong { font-size: clamp(36px, 4vw, 56px); font-weight: 400; letter-spacing: -.02em; color: #202124; }
  .pj__grid h2 { font-size: 22px; font-weight: 500; line-height: 1.2; }
  .pj__grid p { color: var(--text2); }
  .pj-cta { padding-block: 112px; display: flex; flex-direction: column; gap: 32px; } .pj-cta h2 { font-size: clamp(32px, 4vw, 56px); }
</style>
