---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { hero, audiences, stats, usp, phases, featured, moreProjects, wip, reviews, team, faqs, blog } from '../data/content.js';
import { getStats, formatStats } from '../data/notion.js';

const s = formatStats(await getStats());

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="DTRES · Transformación de edificios en Barcelona: due diligence, licencias, interiorismo y obra"
  description="Arquitectura y diseño que elevan el valor de tu inversión. Transformamos edificios en Barcelona y Catalunya: due diligence, cambio de uso, edificios catalogados, interiorismo y obra a precio cerrado."
  jsonLd={[faqLd]}
>
  <!-- HERO -->
  <section class="wrap hero">
    <p class="lbl">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <div class="hero__row">
      <p class="hero__sub">{hero.subtitle}</p>
      <div class="hero__cta">
        <a class="btn" href="#contacto">Agendar llamada gratuita</a>
        <a class="btn btn--ghost" href="#proyectos">Ver proyectos</a>
      </div>
    </div>
  </section>
  <div class="wrap"><img class="ph hero__img" src={hero.image.src} alt={hero.image.alt} width="1600" height="800" /></div>

  <!-- TRABAJAMOS PARA -->
  <section class="wrap aud">
    <div><p class="lbl">Trabajamos para</p><h2 class="aud__title">{audiences.title}</h2></div>
    {audiences.items.map((a) => (
      <div class="aud__item"><h3>{a.title}</h3><p>{a.text}</p></div>
    ))}
  </section>

  <!-- CIFRAS -->
  <section class="dark">
    <div class="wrap stats">
      <div><span class="stats__n">{stats.yearsLabel}</span><span class="stats__t">{stats.yearsText}</span></div>
      <div><span class="stats__n">{stats.projects}</span><span class="stats__t">Proyectos entregados</span></div>
      <div><span class="stats__n">{s.obra}</span><span class="stats__t">De obra gestionada</span></div>
      <div><span class="stats__n">{s.m2}</span><span class="stats__t">Transformados en edificios singulares</span></div>
    </div>
  </section>

  <!-- PATRIMONIO -->
  <section class="wrap usp">
    <img class="ph usp__img" src={usp.image.src} alt={usp.image.alt} width="800" height="1000" loading="lazy" />
    <div class="usp__body">
      <p class="lbl">{usp.eyebrow}</p>
      <h2 class="h2">{usp.title}</h2>
      <p class="usp__text">{usp.text}</p>
      <div class="usp__proofs">
        {usp.proofs.map((p) => (
          <div><span class="lbl">{p.tag}</span><strong>{p.title}</strong><span>{p.text}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- MÉTODO -->
  <section id="metodo" class="stone">
    <div class="wrap method">
      <div class="method__head">
        <div><p class="lbl">Transformación integral · Método en 4 fases</p><h2 class="h2">Del primer análisis a la entrega de llaves.</h2></div>
        <p>Puedes empezar por cualquier fase. Te acompañamos hasta el final.</p>
      </div>
      <div class="method__grid">
        {phases.map((f) => (
          <a class="method__card" href={`/fases/${f.slug}/`}>
            <span class="method__n">{f.n}</span>
            <h3>{f.title}</h3>
            <p class="method__what">{f.what}</p>
            <p class="method__get"><span class="lbl">Recibes</span>{f.get}</p>
            <span class="method__go">Empezar por aquí →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CASO DESTACADO -->
  <section id="proyectos" class="wrap feat">
    <div><p class="lbl">{featured.eyebrow}</p><h2 class="feat__title">{featured.title}</h2></div>
    <div class="feat__imgs">
      <figure><img class="ph" src={featured.before.src} alt={featured.before.alt} width="800" height="600" loading="lazy" /><figcaption class="lbl">Antes</figcaption></figure>
      <figure><img class="ph" src={featured.after.src} alt={featured.after.alt} width="800" height="600" loading="lazy" /><figcaption class="lbl">Después</figcaption></figure>
    </div>
    <div class="feat__cols">
      <div><span class="lbl">Situación</span><p>{featured.situation}</p></div>
      <div><span class="lbl">Transformación</span><p>{featured.transformation}</p></div>
      <div><span class="lbl">Resultado</span><p><strong class="feat__fig">{featured.resultFigure}</strong>{featured.result}</p></div>
    </div>
    {featured.testimonial && (
      <blockquote class="feat__quote"><p>“{featured.testimonial.quote}”</p><footer>{featured.testimonial.author} · {featured.testimonial.role}</footer></blockquote>
    )}
  </section>

  <!-- MÁS PROYECTOS -->
  <section class="wrap more">
    <h2>Más transformaciones</h2>
    <div class="more__grid">
      {moreProjects.map((p) => (
        <article><img class="ph" src={p.img} alt={`${p.tag} · ${p.client}`} width="600" height="750" loading="lazy" /><span class="lbl">{p.tag}</span><h3>{p.client}</h3></article>
      ))}
    </div>
  </section>

  <!-- EN CURSO -->
  <section class="dark">
    <div class="wrap wip">
      <div><p class="lbl">En curso</p><h2 class="h2">Lo que estamos transformando ahora.</h2></div>
      <div class="wip__grid">
        {wip.map((w) => (
          <div class="wip__card"><h3>{w.title}</h3><span class="lbl">{w.client}</span><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- RESEÑAS -->
  <section class="wrap rev">
    <div class="rev__head"><div><p class="lbl">Lo que dicen nuestros clientes</p><h2>Reseñas reales de Google</h2></div>
      <a href="https://search.google.com/local/reviews?placeid=ChIJv3MWA6yXpBIRj6tO7BPYQxA" rel="noopener" target="_blank">Ver todas en Google →</a></div>
    <div class="rev__grid">
      {reviews.map((r) => (
        <figure lang={r.lang || 'es'}><blockquote>“{r.quote}”</blockquote><figcaption>{r.author} · {r.context} · Google</figcaption></figure>
      ))}
    </div>
  </section>

  <!-- EQUIPO -->
  <section id="equipo" class="stone">
    <div class="wrap team">
      <div class="team__body"><p class="lbl">Nosotros</p><h2 class="h2">{team.title}</h2><p>{team.text}</p></div>
      <img class="ph" src={team.image.src} alt={team.image.alt} width="900" height="600" loading="lazy" />
      <div class="team__partners">
        {team.partners.map((p) => (
          <div class="team__p">{p.img && <img class="ph" src={p.img} alt={p.name} width="72" height="72" loading="lazy" />}
            <div><strong>{p.name}</strong><span>{p.role}</span>{p.note && <span class="team__note">{p.note}</span>}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap faq">
    <div><p class="lbl">Preguntas frecuentes</p><h2>Antes de transformar un edificio</h2></div>
    <div>
      {faqs.map((f, i) => (
        <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section class="wrap blog">
    <div class="rev__head"><h2>Guías para propietarios</h2><a href="/blog/">Ir al blog →</a></div>
    <div class="blog__grid">
      {blog.map((b) => (
        <a href={`/blog/${b.slug}/`}><span class="lbl">{b.tag}</span><h3>{b.title}</h3></a>
      ))}
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="dark">
    <div class="wrap cta">
      <p class="lbl">Llamada de consultoría gratuita · 30 min</p>
      <h2 class="cta__title">¿Tienes un edificio que merece otra vida?</h2>
      <p class="cta__text">Cuéntanos qué tienes y qué quieres conseguir. Te diremos qué es posible, cuánto puede costar y por dónde empezar.</p>
      <ContactForm origen="home" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 96px 64px; display: flex; flex-direction: column; gap: 40px; }
  .hero h1 { font-size: clamp(44px, 7.5vw, 112px); line-height: .98; letter-spacing: -.025em; max-width: 16ch; }
  .hero__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .hero__sub { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.4; max-width: 40ch; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__img { aspect-ratio: 2 / 1; }

  .aud { padding-block: 120px 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 48px; }
  .aud__title { font-size: 36px; line-height: 1.1; margin-top: 16px; }
  .aud__item { border-top: 1px solid var(--ink); padding-top: 20px; display: flex; flex-direction: column; gap: 12px; }
  .aud__item h3 { font-size: 22px; } .aud__item p { color: var(--text2); }

  .stats { padding-block: 80px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; }
  .stats div { display: flex; flex-direction: column; gap: 8px; }
  .stats__n { font-size: clamp(44px, 5vw, 72px); font-weight: 500; line-height: 1; letter-spacing: -.02em; }
  .stats__t { color: var(--sage); }

  .usp { padding-block: 128px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: center; }
  .usp__img { aspect-ratio: 4 / 5; }
  .usp__body { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .usp__text { font-size: 19px; line-height: 1.55; max-width: 46ch; }
  .usp__proofs { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; border-top: 1px solid rgba(32,33,36,.2); padding-top: 24px; }
  .usp__proofs div { display: flex; flex-direction: column; gap: 8px; }
  .usp__proofs strong { font-weight: 500; } .usp__proofs span:last-child { color: var(--text2); font-size: 15px; }

  .method { padding-block: 120px; display: flex; flex-direction: column; gap: 56px; }
  .method__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .method__head .h2 { max-width: 20ch; margin-top: 16px; } .method__head > p { max-width: 36ch; }
  .method__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2px; background: var(--line); }
  .method__card { display: flex; flex-direction: column; gap: 16px; padding: 32px 28px 36px; background: var(--bone); text-decoration: none; min-height: 380px; }
  .method__card h3 { font-size: 28px; } .method__n { font-size: 14px; color: var(--muted); }
  .method__what { color: var(--text2); font-size: 15px; }
  .method__get { font-size: 15px; border-top: 1px solid var(--line); padding-top: 14px; } .method__get .lbl { display: block; margin-bottom: 6px; }
  .method__go { margin-top: auto; font-size: 14px; font-weight: 500; }

  .feat { padding-block: 128px 64px; display: flex; flex-direction: column; gap: 48px; }
  .feat__title { font-size: clamp(34px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -.02em; margin-top: 16px; }
  .feat__imgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .feat__imgs figure { margin: 0; display: flex; flex-direction: column; gap: 8px; } .feat__imgs img { aspect-ratio: 4 / 3; }
  .feat__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px; }
  .feat__cols div { border-top: 1px solid var(--ink); padding-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  .feat__fig { display: block; font-size: 28px; font-weight: 500; line-height: 1.1; }
  .feat__quote { margin: 0; border-top: 1px solid var(--line); padding-top: 40px; } .feat__quote p { font-size: clamp(22px, 2.4vw, 32px); max-width: 40ch; }

  .more { padding-block: 32px 120px; display: flex; flex-direction: column; gap: 40px; } .more > h2 { font-size: 36px; }
  .more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; }
  @media (max-width: 860px) { .more__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .more__grid { grid-template-columns: 1fr; } }
  .more__grid article { display: flex; flex-direction: column; gap: 12px; } .more__grid img { aspect-ratio: 4 / 5; } .more__grid h3 { font-size: 20px; }

  .wip { padding-block: 112px; display: flex; flex-direction: column; gap: 48px; } .wip .h2 { max-width: 22ch; margin-top: 16px; }
  .wip__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2px; background: rgba(234,234,228,.18); }
  .wip__card { display: flex; flex-direction: column; gap: 12px; padding: 32px 28px; background: var(--ink); }
  .wip__card h3 { font-size: 24px; line-height: 1.25; } .wip__card p { color: #c9c8bb; }

  .rev { padding-block: 120px; display: flex; flex-direction: column; gap: 48px; }
  .rev__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; } .rev__head h2 { font-size: 36px; margin-top: 16px; }
  .rev__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .rev__grid figure { margin: 0; display: flex; flex-direction: column; gap: 20px; padding: 32px; background: var(--card); border: 1px solid rgba(32,33,36,.12); }
  .rev__grid blockquote { margin: 0; font-size: 18px; } .rev__grid figcaption { margin-top: auto; font-size: 14px; color: var(--muted); }

  .team { padding-block: 112px; display: grid; grid-template-columns: 1fr 1.5fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .team { grid-template-columns: 1fr; } }
  .team__body { display: flex; flex-direction: column; gap: 24px; } .team__body > p:last-child { font-size: 18px; max-width: 44ch; }
  .team > img { aspect-ratio: 3 / 2; }
  .team__partners { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; border-top: 1px solid rgba(32,33,36,.2); padding-top: 32px; }
  .team__p { display: flex; gap: 16px; align-items: center; } .team__p img { width: 72px; height: 72px; border-radius: 50%; flex: none; }
  .team__p div { display: flex; flex-direction: column; gap: 4px; } .team__p strong { font-weight: 500; font-size: 18px; } .team__p span { font-size: 14px; color: var(--text2); }
  .team__note { color: var(--muted) !important; font-size: 13px !important; }

  .faq { padding-block: 120px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 56px; } .faq h2 { font-size: 36px; margin-top: 16px; }
  .faq details { border-top: 1px solid var(--ink); padding-block: 22px; } .faq details:last-child { border-bottom: 1px solid var(--ink); }
  .faq summary { font-size: 19px; font-weight: 500; cursor: pointer; } .faq details p { margin-top: 14px; color: var(--text2); }

  .blog { padding-block: 112px; display: flex; flex-direction: column; gap: 40px; border-top: 1px solid var(--line); } .blog h2 { font-size: 36px; }
  .blog__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
  .blog__grid a { display: flex; flex-direction: column; gap: 12px; text-decoration: none; border-top: 1px solid var(--ink); padding-top: 18px; } .blog__grid h3 { font-size: 21px; line-height: 1.3; }

  .cta { padding-block: 128px; display: flex; flex-direction: column; gap: 32px; align-items: flex-start; }
  .cta__title { font-size: clamp(38px, 5.6vw, 80px); line-height: 1; letter-spacing: -.02em; max-width: 16ch; }
  .cta__text { font-size: 19px; max-width: 44ch; color: #c9c8bb; }
</style>
