---
import { ui, routes, code } from '../i18n/index.js';
const { origen = 'home', lang = 'es' } = Astro.props;
const t = ui[lang].form;
---
<form class="cf" method="post" action="/api/contacto">
  <input type="hidden" name="origen" value={origen} />
  <input type="hidden" name="idioma" value={code[lang]} />
  <label class="cf__hp" aria-hidden="true">{t.hp} <input name="website" tabindex="-1" autocomplete="off" /></label>
  <div class="cf__grid">
    <label>{t.name}<input name="nombre" required autocomplete="name" /></label>
    <label>{t.email}<input name="email" type="email" required autocomplete="email" /></label>
    <label>{t.phone}<input name="telefono" type="tel" autocomplete="tel" /></label>
    <label>{t.company}<input name="empresa" autocomplete="organization" /></label>
    <label>{t.profile}
      <select name="perfil">
        {t.profiles.map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
    </label>
    <label class="cf__full">{t.message}<textarea name="mensaje" rows="4"></textarea></label>
  </div>
  <p class="cf__legal">{t.legal} <a href={routes.privacy[lang]}>{t.privacy}</a>.</p>
  <button class="btn btn--light" type="submit">{t.submit}</button>
</form>
<style>
  .cf { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 760px; }
  .cf__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .cf label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: #c9c8bb; }
  .cf__full { grid-column: 1 / -1; }
  .cf input, .cf select, .cf textarea { font: inherit; color: var(--bone); background: transparent; border: 1px solid rgba(234,234,228,.35); padding: 12px 14px; min-height: 48px; }
  .cf select option { color: var(--ink); }
  .cf__legal { font-size: 13px; color: #c9c8bb; }
  .cf__hp { position: absolute; left: -9999px; }
  .cf button { align-self: flex-start; border: 0; cursor: pointer; font: inherit; font-weight: 500; }
</style>
