---
import { site } from '../data/content.js';
import { ui, routes, phasePath, langs, code } from '../i18n/index.js';
import { getContent } from '../data/i18n-content.js';
const { lang = 'es', alternates = null } = Astro.props;
const t = ui[lang];
const { phases } = getContent(lang);
const home = routes.home[lang];
const links = [
  [`${home}#metodo`, t.nav.method],
  [routes.projects[lang], t.nav.projects],
  [routes.team[lang], t.nav.about],
  [routes.blog[lang], t.nav.blog],
];
const langHref = (l) => (alternates && alternates[l]) || routes.home[l];
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href={home} class="hdr__logo" aria-label="DTRES">DTRES</a>
    <nav class="hdr__nav" aria-label="Principal">
      {links.map(([h, l]) => <a href={h}>{l}</a>)}
    </nav>
    <div class="hdr__right">
      <span class="hdr__social"><a href={site.instagram} aria-label="Instagram @estudio_detres" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg></a><a href={site.linkedin} aria-label="LinkedIn DTRES" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.35h-4v-4.74c0-1.13-.02-2.59-1.58-2.59-1.58 0-1.82 1.23-1.82 2.5v4.83h-4v-11Z"/></svg></a></span>
      <a class="btn hdr__cta" href={`${home}#contacto`}>{t.cta}</a>
      <details class="hdr__lang">
        <summary aria-label="Idioma">{code[lang]}<svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></summary>
        <div class="hdr__lang-list">
          {langs.filter((l) => l !== lang).map((l) => <a href={langHref(l)} hreflang={l} lang={l}>{code[l]}</a>)}
        </div>
      </details>
      <details class="hdr__menu">
        <summary aria-label="Menú"><span></span><span></span></summary>
        <div class="hdr__drawer">
          {links.map(([h, l]) => <a href={h}>{l}</a>)}
          <span class="hdr__drawer-social"><a href={site.instagram} aria-label="Instagram @estudio_detres" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg></a><a href={site.linkedin} aria-label="LinkedIn DTRES" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.35h-4v-4.74c0-1.13-.02-2.59-1.58-2.59-1.58 0-1.82 1.23-1.82 2.5v4.83h-4v-11Z"/></svg></a></span>
          <div class="hdr__drawer-lang">
            {langs.map((l) => (l === lang ? <span>{code[l]}</span> : <a href={langHref(l)} hreflang={l}>{code[l]}</a>))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector('.hdr__menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { menu?.removeAttribute('open'); document.querySelector('.hdr__lang')?.removeAttribute('open'); } });
  document.addEventListener('click', (e) => { const l = document.querySelector('.hdr__lang'); if (l && !l.contains(e.target)) l.removeAttribute('open'); });
</script>
<style>
  .hdr { border-bottom: 1px solid var(--line); position: relative; }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 18px; }
  .hdr__logo { font-size: 24px; font-weight: 600; letter-spacing: .06em; text-decoration: none; }
  .hdr__nav { display: flex; gap: 28px; font-size: 15px; }
  .hdr__nav a { text-decoration: none; padding-block: 12px; }
  .hdr__right { display: flex; align-items: center; gap: 16px; }
  .hdr__lang { position: relative; font-size: 12px; letter-spacing: .08em; color: var(--muted); }
  .hdr__lang summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 5px; min-height: 44px; padding-inline: 2px; }
  .hdr__lang summary::-webkit-details-marker { display: none; }
  .hdr__lang[open] summary svg { transform: rotate(180deg); }
  .hdr__lang-list { position: absolute; right: -10px; top: 100%; background: var(--bone); border: 1px solid var(--line); display: flex; flex-direction: column; z-index: 30; }
  .hdr__lang-list a { text-decoration: none; color: var(--ink); padding: 10px 16px; }
  .hdr__lang-list a:hover { background: rgba(32,33,36,.06); }
  .hdr__cta { min-height: 44px; padding: 0 20px; font-size: 15px; }
  .hdr__menu { display: none; }
  .hdr__menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: flex; flex-direction: column; justify-content: center; gap: 7px; padding: 0 10px; }
  .hdr__menu summary::-webkit-details-marker { display: none; }
  .hdr__menu summary span { height: 1.5px; background: var(--ink); display: block; }
  .hdr__drawer { position: absolute; left: 0; right: 0; top: 100%; background: var(--bone); border-bottom: 1px solid var(--line); z-index: 20;
    display: flex; flex-direction: column; padding: 8px max(24px, 4vw) 24px; }
  .hdr__drawer a { text-decoration: none; font-size: 20px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .hdr__drawer-lang { display: flex; gap: 20px; padding-top: 16px; font-size: 14px; letter-spacing: .08em; }
  .hdr__drawer-lang span, .hdr__drawer-lang a { border: 0; font-size: 15px; padding: 12px 4px; min-width: 44px; color: var(--muted); }
  .hdr__drawer-lang span { color: var(--ink); }
  @media (max-width: 900px) { .hdr__nav, .hdr__lang { display: none; } .hdr__menu { display: block; } }
  @media (max-width: 420px) { .hdr__cta { display: none; } }
  .hdr__social { display: flex; gap: 2px; }
  .hdr__social a, .hdr__drawer-social a { display: grid; place-items: center; width: 40px; height: 44px; color: var(--ink); border: 0 !important; padding: 0 !important; }
  .hdr__social a:hover { opacity: .6; }
  .hdr__drawer-social { display: flex; gap: 8px; padding-top: 8px; margin-left: -10px; }
  @media (max-width: 900px) { .hdr__social { display: none; } }
</style>
