---
import Base from '../layouts/Base.astro';
import { ui, routes } from '../i18n/index.js';
import * as es from '../data/legal.es.js';
import * as ca from '../data/legal.ca.js';
import * as en from '../data/legal.en.js';

const { lang = 'es', page } = Astro.props; // page: legal | privacy | cookies
const L = { es, ca, en }[lang];
const d = L[page];
---
<Base title={`${d.title} · DTRES`} description={d.desc} lang={lang} alternates={routes[page]}>
  <article class="wrap lg">
    <header><p class="lbl">{ui[lang].footer.legal}</p><h1>{d.title}</h1><p class="lg__upd">{ui[lang].updated}: {L.updated}</p></header>
    {d.sections.map(([h, html]) => (
      <section><h2>{h}</h2><div set:html={html} /></section>
    ))}
  </article>
</Base>
<style>
  .lg { padding-block: 96px 120px; display: flex; flex-direction: column; gap: 40px; }
  .lg > * { max-width: 820px; width: 100%; }
  .lg header { display: flex; flex-direction: column; gap: 16px; }
  .lg h1 { font-size: clamp(40px, 5vw, 72px); line-height: 1; letter-spacing: -.02em; }
  .lg__upd { color: var(--muted); font-size: 14px; }
  .lg section { border-top: 1px solid var(--line); padding-top: 24px; display: grid; grid-template-columns: minmax(180px, 1fr) 2fr; gap: 24px; }
  .lg h2 { font-size: 19px; }
  .lg section div { display: flex; flex-direction: column; gap: 12px; color: var(--text2); min-width: 0; }
  .lg ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  @media (max-width: 700px) { .lg section { grid-template-columns: 1fr; gap: 12px; } }
</style>
