---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContent } from '../data/i18n-content.js';
import { site } from '../data/content.js';
import { ui, routes, phasePath, postPath, langs } from '../i18n/index.js';
import { getPosts } from '../data/blog.js';
const { lang = 'es', post } = Astro.props;
const t = ui[lang].blog;
const phase = getContent(lang).phases.find((f) => f.title === post.phase || f.alt?.includes(post.phase));
const df = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
const ref = post.ref || post.slug;
const alternates = { [lang]: postPath(lang, post.slug) };
for (const l of langs) {
  if (l === lang) continue;
  const m = (await getPosts(l)).find((p) => (p.ref || p.slug) === ref);
  if (m) alternates[l] = postPath(l, m.slug);
}
const Content = post.entry ? (await post.entry.render()).Content : null;
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description,
  datePublished: post.date.toISOString(), inLanguage: lang, keywords: post.keyword,
  author: { '@type': 'Person', name: post.author }, publisher: { '@id': `${site.url}/#org` },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={post.title.length > 62 ? post.title : `${post.title} · DTRES`} description={post.description} lang={lang} alternates={alternates} jsonLd={[ld]}>
  <article class="wrap po">
    <header class="po__head">
      <a class="po__back" href={routes.blog[lang]}>{t.back}</a>
      <p class="lbl">{[post.phase, df.format(post.date)].filter(Boolean).join(' · ')}</p>
      <h1>{post.title}</h1>
      <p class="po__lead">{post.description}</p>
      <p class="po__by">{t.by} {post.author}</p>
    </header>
    <div class="po__body">
      {Content ? <Content /> : <Fragment set:html={post.html} />}
    </div>
    {phase && (
      <a class="po__phase" href={phasePath(lang, phase.slug)}>
        <span class="lbl">{t.related} · {phase.n}</span><strong>{phase.seoTitle}</strong><span>{phase.what}</span>
      </a>
    )}
  </article>
  <section id="contacto" class="dark">
    <div class="wrap po-cta">
      <h2>{t.ctaTitle}</h2>
      <ContactForm origen={`blog-${post.slug}`} lang={lang} />
    </div>
  </section>
</Base>
<style>
  .po { padding-block: clamp(48px, 8vw, 72px) 112px; display: flex; flex-direction: column; gap: 48px; }
  .po__head { display: flex; flex-direction: column; gap: 20px; max-width: 900px; }
  .po__back { font-size: 15px; text-decoration: none; color: var(--muted); padding-block: 10px; align-self: flex-start; }
  .po h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1.04; letter-spacing: -.02em; }
  .po__lead { font-size: 21px; line-height: 1.45; max-width: 52ch; color: var(--text2); }
  .po__by { font-size: 14px; color: var(--muted); }
  .po__body { max-width: 68ch; font-size: 18px; line-height: 1.65; display: flex; flex-direction: column; gap: 18px; }
  .po__body :global(h2) { font-size: 28px; line-height: 1.2; margin-top: 24px; }
  .po__body :global(h3) { font-size: 21px; margin-top: 12px; }
  .po__body :global(p) { margin: 0; }
  .po__body :global(ul), .po__body :global(ol) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }
  .po__body :global(blockquote) { margin: 0; border-left: 2px solid var(--sage); padding-left: 20px; color: var(--text2); }
  .po__body :global(img) { width: 100%; }
  .po__phase { max-width: 68ch; text-decoration: none; background: var(--card); padding: 28px; display: flex; flex-direction: column; gap: 8px; }
  .po__phase strong { font-size: 22px; font-weight: 500; } .po__phase span:last-child { color: var(--text2); }
  .po-cta { padding-block: clamp(64px, 10vw, 112px); display: flex; flex-direction: column; gap: 32px; } .po-cta h2 { font-size: clamp(32px, 4vw, 56px); }
</style>
