---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContent } from '../data/i18n-content.js';
import { site } from '../data/content.js';
import { ui, langs, phasePath } from '../i18n/index.js';

const { lang = 'es', f } = Astro.props;
const { phases } = getContent(lang);
const t = ui[lang].phase;
const others = phases.filter((p) => p.id !== f.id);
const alternates = Object.fromEntries(langs.map((l) => [l, phasePath(l, getContent(l).phases.find((p) => p.id === f.id).slug)]));

const short = (txt, max = 160) => { let out = ''; for (const s of txt.split(/(?<=\.)\s+/)) { if ((out + ' ' + s).trim().length > max) break; out = (out + ' ' + s).trim(); } return out || txt.slice(0, max); };
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: f.seoTitle,
  description: f.intro,
  provider: { '@id': `${site.url}/#org` },
  areaServed: site.areaServed,
};
---
<Base title={`${f.seoTitle} · DTRES`} description={short(f.intro)} jsonLd={[serviceLd]} lang={lang} alternates={alternates}>
  <section class="wrap ph-hero">
    <p class="lbl">{t.label} {f.n} · {t.integral}</p>
    <h1>{f.seoTitle}</h1>
    <p class="ph-hero__intro">{f.intro}</p>
    <a class="btn" href="#contacto">{ui[lang].ctaFree}</a>
  </section>

  <section class="wrap ph-body">
    <div>
      <h2>{t.includes}</h2>
      <ul>{f.includes.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="ph-get">
      <span class="lbl">{t.youGet}</span>
      <p>{f.get}</p>
      <p class="ph-note">{t.note}</p>
    </div>
  </section>

  <section class="stone">
    <div class="wrap ph-next">
      <h2>{t.others}</h2>
      <div class="ph-next__grid">
        {others.map((o) => (
          <a href={phasePath(lang, o.slug)}><span class="lbl">{o.n}</span><h3>{o.title}</h3><p>{o.what}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="dark">
    <div class="wrap ph-cta">
      <h2>{t.ctaPre} {f.title.toLowerCase()}?</h2>
      <ContactForm origen={`fase-${f.id}`} lang={lang} />
    </div>
  </section>
</Base>
<style>
  .ph-hero { padding-block: clamp(48px, 8vw, 96px) 72px; display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .ph-hero h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 18ch; }
  .ph-hero__intro { font-size: 21px; line-height: 1.45; max-width: 52ch; }
  .ph-body { padding-block: clamp(48px, 8vw, 72px) 120px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 56px; }
  .ph-body h2 { font-size: 32px; margin-bottom: 20px; }
  .ph-body ul { margin: 0; padding: 0; list-style: none; }
  .ph-body li { border-top: 1px solid var(--line); padding-block: 14px; }
  .ph-get { background: var(--card); padding: 32px; display: flex; flex-direction: column; gap: 12px; align-self: start; }
  .ph-get p:first-of-type { font-size: 22px; line-height: 1.35; }
  .ph-note { color: var(--muted); }
  .ph-next { padding-block: clamp(48px, 8vw, 96px); display: flex; flex-direction: column; gap: 32px; } .ph-next h2 { font-size: 32px; }
  .ph-next__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 24px; }
  .ph-next__grid a { text-decoration: none; background: var(--bone); padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .ph-next__grid h3 { font-size: 24px; } .ph-next__grid p { color: var(--text2); font-size: 15px; }
  .ph-cta { padding-block: clamp(64px, 10vw, 112px); display: flex; flex-direction: column; gap: 32px; } .ph-cta h2 { font-size: clamp(32px, 4vw, 56px); }
</style>
