---
import Base from '../layouts/Base.astro';
import { getPosts } from '../data/blog.js';
import { ui, routes, postPath } from '../i18n/index.js';
const { lang = 'es' } = Astro.props;
const t = ui[lang].blog;
const posts = await getPosts(lang);
const df = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
const ld = {
  '@context': 'https://schema.org', '@type': 'Blog', name: t.title, inLanguage: lang,
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: new URL(postPath(lang, p.slug), Astro.site).href, datePublished: p.date.toISOString() })),
};
---
<Base title={t.metaTitle} description={t.sub} lang={lang} alternates={routes.blog} jsonLd={[ld]}>
  <section class="wrap bl-hero">
    <p class="lbl">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="bl-hero__sub">{t.sub}</p>
  </section>
  <section class="wrap bl">
    {posts.length === 0 && <p class="bl__empty">{t.empty}</p>}
    {posts.map((p) => (
      <a class="bl__item" href={postPath(lang, p.slug)}>
        <span class="lbl">{[p.phase, df.format(p.date)].filter(Boolean).join(' · ')}</span>
        <h2>{p.title}</h2>
        <p>{p.description}</p>
        <span class="bl__go">{t.read}</span>
      </a>
    ))}
  </section>
</Base>
<style>
  .bl-hero { padding-block: clamp(48px, 8vw, 96px) 56px; display: flex; flex-direction: column; gap: 24px; }
  .bl-hero h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 18ch; }
  .bl-hero__sub { font-size: 21px; line-height: 1.45; max-width: 52ch; }
  .bl { padding-block: 0 clamp(72px, 10vw, 120px); display: flex; flex-direction: column; }
  .bl__item { text-decoration: none; border-top: 1px solid var(--line); padding-block: 32px; display: grid; grid-template-columns: 1fr 2fr auto; gap: 8px 32px; align-items: baseline; }
  .bl__item:last-child { border-bottom: 1px solid var(--line); }
  .bl__item h2 { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2; grid-column: 2; }
  .bl__item p { color: var(--text2); grid-column: 2; max-width: 60ch; }
  .bl__item .lbl { grid-column: 1; grid-row: 1; }
  .bl__go { grid-column: 3; grid-row: 1; font-size: 15px; }
  .bl__item:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  .bl__empty { font-size: 19px; color: var(--muted); }
  @media (max-width: 760px) { .bl__item { grid-template-columns: 1fr; } .bl__item h2, .bl__item p, .bl__item .lbl, .bl__go { grid-column: 1; grid-row: auto; } }
</style>
