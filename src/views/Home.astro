---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContent } from '../data/i18n-content.js';
import { moreImgs } from '../data/content.js';
import { getStats, formatStats } from '../data/notion.js';
import { getPosts } from '../data/blog.js';
import { srcset } from '../lib/img.js';
import { ui, routes, phasePath, langs, fmt } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const { hero, audiences, stats, usp, phases, featured, reviews, team, faqs, meta, clients, allProjects, home2 } = getContent(lang);
const moreProjects = moreImgs.map((img) => allProjects.find((p) => p.img === img)).filter(Boolean).map((p) => ({ ...p, tag: `${p.use} · ${fmt(p.m2, lang)} m²` }));
const icons = {
  split: '<rect x="3" y="3" width="11" height="11"/><rect x="18" y="3" width="11" height="11"/><rect x="3" y="18" width="11" height="11"/><rect x="18" y="18" width="11" height="11" stroke-dasharray="3 2.5"/>',
  route: '<circle cx="6" cy="6" r="3"/><circle cx="26" cy="9" r="3"/><circle cx="26" cy="23" r="3"/><circle cx="6" cy="26" r="3"/><path d="M9 6h7v17h7M16 9h7M9 26h7"/>',
  heritage: '<path d="M3 12 16 4l13 8z"/><path d="M3 28h26M5 25h22M8 14v11M13 14v11M19 14v11M24 14v11"/>',
  invest: '<path d="M4 4v24h24"/><path d="M8 22l6-7 5 4 8-10"/><path d="M21 9h6v6"/>',
  owner: '<circle cx="10" cy="16" r="6"/><path d="M16 16h13M24 16v5M28 16v4"/>',
  institution: '<path d="M6 28V9h20v19M3 28h26M13 28v-6a3 3 0 0 1 6 0v6M10 13h3M19 13h3M10 18h3M19 18h3M16 9V3h5v3h-5"/>',
  company: '<rect x="6" y="5" width="20" height="13"/><path d="M13 22h6M16 18v4M3 26h26M7 26v3M25 26v3"/>',
  doubt: '<circle cx="16" cy="16" r="12"/><path d="M12.5 12.5a3.5 3.5 0 1 1 5 3.2c-1 .5-1.5 1.2-1.5 2.3v1"/><path d="M16 23v.5"/>',
  clock: '<circle cx="16" cy="16" r="12"/><path d="M16 9v7l5 3"/>',
  blocked: '<path d="M3 12 16 4l13 8z"/><path d="M3 28h26M8 14v11M13 14v11M19 14v11M24 14v11"/><path d="M4 4l24 24"/>',
  cost: '<path d="M4 4v24h24"/><path d="M8 22l6-4 5 3 9-13"/><path d="M22 8h6v6"/>',
  ready: '<rect x="4" y="6" width="24" height="22"/><path d="M4 12h24M10 3v6M22 3v6M11 20l4 4 7-8"/>',
};
const t = ui[lang].home;
const T = ui[lang];
const home = routes.home[lang];
const s = formatStats(await getStats(), lang);
const blog = (await getPosts(lang)).slice(0, 3);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={meta.homeTitle} description={meta.homeDesc} jsonLd={[faqLd]} lang={lang} alternates={routes.home}>
  <!-- 1. DESTINO -->
  <section class="wrap hero">
    <p class="lbl">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <div class="hero__row">
      <p class="hero__sub">{hero.subtitle}</p>
      <div class="hero__cta">
        <a class="btn" href="#contacto">{T.ctaFree}</a>
        <a class="btn btn--ghost" href={routes.projects[lang]}>{T.seeProjects}</a>
      </div>
    </div>
    <ul class="chips" aria-label={t.for}>
      <li class="chips__lbl">{t.for}</li>
      {audiences.items.map((a) => <li class="chip"><svg viewBox="0 0 32 32" aria-hidden="true" set:html={icons[a.icon]} />{a.title}</li>)}
    </ul>
  </section>
  <div class="wrap"><img class="ph hero__img" src={hero.image.src} srcset={srcset(hero.image.src)} sizes="(min-width: 1680px) 1520px, (min-width: 1280px) 1280px, 100vw" fetchpriority="high" alt={hero.image.alt} width="1600" height="800" /></div>
  <div class="wrap logos">
    <p class="lbl">{t.clientsTitle}</p>
    <ul class="logos__row">
      {clients.map((c) => <li><img src={c.logo} alt={c.name} title={c.name} loading="lazy" /></li>)}
    </ul>
  </div>

  <!-- 2. DOLORES -->
  <section class="dark">
    <div class="wrap pains">
      <div><p class="lbl">{home2.pains.eyebrow}</p><h2 class="h2">{home2.pains.title}</h2></div>
      <ul class="pains__grid">
        {home2.pains.items.map((x) => <li><svg viewBox="0 0 32 32" aria-hidden="true" set:html={icons[x.icon]} /><p>{x.text}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 3. PRUEBA: CASO -->
  <section id="proyectos" class="wrap feat">
    <div><p class="lbl">{featured.eyebrow}</p><h2 class="feat__title">{featured.title}</h2></div>
    <div class="feat__imgs">
      <figure><img class="ph" src={featured.before.src} srcset={srcset(featured.before.src)} sizes="(min-width: 900px) 50vw, 100vw" alt={featured.before.alt} width="800" height="600" loading="lazy" /><figcaption class="lbl">{t.before}</figcaption></figure>
      <figure><img class="ph" src={featured.after.src} srcset={srcset(featured.after.src)} sizes="(min-width: 900px) 50vw, 100vw" alt={featured.after.alt} width="800" height="600" loading="lazy" /><figcaption class="lbl">{t.after}</figcaption></figure>
    </div>
    <div class="feat__cols">
      <div><span class="lbl">{t.situation}</span><p>{featured.situation}</p></div>
      <div><span class="lbl">{t.transformation}</span><p>{featured.transformation}</p></div>
      <div><span class="lbl">{t.result}</span><p><strong class="feat__fig">{featured.resultFigure}</strong>{featured.result}</p></div>
    </div>
  </section>

  <!-- 4. SERVICIO + CTA -->
  <section id="metodo" class="stone">
    <div class="wrap method">
      <div class="method__head">
        <div><p class="lbl">{t.methodEyebrow}</p><h2 class="h2">{home2.methodTitle}</h2></div>
        <p>{t.methodNote}</p>
      </div>
      <div class="method__grid">
        {phases.map((f) => (
          <a class="method__card" href={phasePath(lang, f.slug)}>
            <span class="method__n">{f.n}</span>
            <h3>{f.title}</h3>
            <p class="method__short">{home2.phaseShort[f.id]}</p>
            <span class="method__go">{t.startHere}</span>
          </a>
        ))}
      </div>
      <a class="btn method__cta" href="#contacto">{home2.methodCta}</a>
    </div>
  </section>

  <!-- 5-6. BENEFICIOS: LICENCIAS -->
  <section class="wrap usp">
    <img class="ph usp__img" src={usp.image.src} srcset={srcset(usp.image.src)} sizes="(min-width: 900px) 50vw, 100vw" alt={usp.image.alt} width="800" height="1000" loading="lazy" />
    <div class="usp__body">
      <p class="lbl">{usp.eyebrow}</p>
      <h2 class="h2">{usp.title}</h2>
      <div class="usp__proofs">
        {usp.proofs.map((p) => (
          <div>{p.icon && <svg class="usp__icon" viewBox="0 0 32 32" aria-hidden="true" set:html={icons[p.icon]} />}<strong>{p.title}</strong><span class="lbl">{p.tag}</span><span>{p.text}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. BONUS + CTA -->
  <section class="wrap">
    <div class="bonus">
      <div><p class="lbl">{home2.bonus.eyebrow}</p><h2>{home2.bonus.title}</h2><p>{home2.bonus.text}</p></div>
      <a class="btn" href="#contacto">{home2.bonus.cta}</a>
    </div>
  </section>

  <!-- 8. AUTORIDAD: CIFRAS + EQUIPO -->
  <section id="equipo" class="stone">
    <div class="wrap auth">
      <p class="lbl">{home2.authority}</p>
      <div class="stats">
        <div><span class="stats__n">{stats.yearsLabel}</span><span class="stats__t">{stats.yearsText}</span></div>
        <div><span class="stats__n">{stats.projects}</span><span class="stats__t">{t.projectsDone}</span></div>
        <div><span class="stats__n">{s.obra}</span><span class="stats__t">{t.works}</span></div>
        <div><span class="stats__n">{s.m2}</span><span class="stats__t">{t.m2}</span></div>
      </div>
      <div class="team">
        <div class="team__body"><h2 class="h2">{team.title}</h2><p>{team.text}</p><a class="team__more" href={routes.team[lang]}>{ui[lang].teamPage.more}</a></div>
        <img class="ph" src={team.image.src} srcset={srcset(team.image.src)} sizes="(min-width: 860px) 60vw, 100vw" alt={team.image.alt} width="900" height="600" loading="lazy" />
        <div class="team__partners">
          {team.partners.map((p) => (
            <div class="team__p">{p.img && <img class="ph" src={p.img} alt={p.name} width="72" height="72" loading="lazy" />}
              <div><strong>{p.name}</strong><span>{p.role}</span>{p.title && <span class="team__role">{p.title}</span>}{p.note && <span class="team__note">{p.note}</span>}</div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. TESTIMONIOS + PROYECTOS -->
  <section class="wrap rev">
    <div class="rev__head"><div><p class="lbl">{t.revEyebrow}</p><h2>{t.revTitle}</h2></div>
      <a href="https://search.google.com/local/reviews?placeid=ChIJv3MWA6yXpBIRj6tO7BPYQxA" rel="noopener" target="_blank">{t.revAll}</a></div>
    <div class="rev__grid">
      {reviews.map((r) => (
        <figure lang={r.lang || 'es'}><span class="rev__stars" role="img" aria-label={t.stars(r.rating)}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span><blockquote>“{r.quote}”</blockquote><figcaption>{r.author} · {r.context} · Google</figcaption></figure>
      ))}
    </div>
  </section>
  <section class="wrap more">
    <div class="rev__head"><h2>{t.more}</h2><a href={routes.projects[lang]}>{t.allProjects}</a></div>
    <div class="more__grid">
      {moreProjects.map((p) => (
        <article><img class={p.bw ? "ph bw" : "ph"} src={p.img} srcset={srcset(p.img)} sizes="(min-width: 860px) 33vw, (min-width: 520px) 50vw, 100vw" alt={`${p.tag} · ${p.client}`} width="600" height="750" loading="lazy" /><h3>{p.tag}</h3><span class="lbl">{p.client}</span></article>
      ))}
    </div>
  </section>

  <!-- FAQ (objeciones) -->
  <section class="wrap faq">
    <div><p class="lbl">{t.faqEyebrow}</p><h2>{t.faqTitle}</h2></div>
    <div>
      {faqs.map((f, i) => (
        <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <!-- 10. DESTINO + CTA FINAL -->
  <section id="contacto" class="dark">
    <div class="wrap cta">
      <p class="lbl">{t.ctaEyebrow}</p>
      <h2 class="cta__title">{t.ctaTitle}</h2>
      <p class="cta__text">{t.ctaText}</p>
      <ContactForm origen="home" lang={lang} />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(48px, 8vw, 96px) 64px; display: flex; flex-direction: column; gap: 40px; }
  .hero h1 { font-size: clamp(44px, 7.5vw, 112px); line-height: .98; letter-spacing: -.025em; max-width: 16ch; }
  .hero__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .hero__sub { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.4; max-width: 40ch; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__img { aspect-ratio: 2 / 1; object-fit: cover; }
  @media (max-width: 700px) { .hero__img { aspect-ratio: 4 / 5; object-position: 60% center; } }

  .aud { padding-block: clamp(64px, 10vw, 120px) clamp(56px, 8vw, 96px); display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 900px) { .aud { grid-template-columns: 1fr 1.15fr; gap: 80px; align-items: start; } }
  .aud__title { font-size: clamp(28px, 3.4vw, 44px); line-height: 1.1; margin-top: 16px; max-width: 18ch; }
  .aud__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .aud__item { border-bottom: 1px solid var(--line); padding-block: 22px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 8px 32px; align-items: center; }
  @media (max-width: 600px) {
    .aud__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
    .aud__item { grid-template-columns: 1fr; padding-block: 16px; gap: 6px; align-content: start; align-items: start; }
    .aud__item h3 { font-size: 16px !important; } .aud__item p { font-size: 13.5px !important; line-height: 1.4; }
    .aud__title { font-size: 26px; }
  }
  @media (max-width: 340px) { .aud__list { grid-template-columns: 1fr; } }
  .aud__name { display: flex; align-items: center; gap: 14px; } .aud__icon { flex: none; width: 32px; height: 32px; fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: square; stroke-linejoin: miter; }
  @media (max-width: 600px) { .aud__name { flex-direction: column; align-items: flex-start; gap: 10px; } .aud__icon { width: 28px; height: 28px; } }
  .aud__item h3 { font-size: 21px; line-height: 1.25; } .aud__item p { color: var(--text2); font-size: 16px; }

  .logos { padding-block: 0 clamp(48px, 8vw, 80px); display: flex; flex-direction: column; gap: 28px; border-top: 1px solid rgba(234,234,228,.15); padding-top: 40px; }
  .logos .lbl { color: #8f8e82; }
  .logos__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px 36px; align-items: center; }
  @media (max-width: 1100px) { .logos__row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .logos__row li { display: flex; justify-content: center; }
  .logos__row img { width: 100%; max-width: 168px; height: auto; }
  @media (max-width: 620px) { .logos__row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  .stats { padding-block: clamp(48px, 8vw, 80px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 40px; }
  .stats div { display: flex; flex-direction: column; gap: 8px; }
  .stats__n { font-size: clamp(34px, 3.7vw, 60px); font-weight: 500; line-height: 1; letter-spacing: -.02em; white-space: nowrap; }
  .stats__t { color: var(--sage); }

  .usp { padding-block: clamp(64px, 10vw, 128px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 64px; align-items: center; }
  .usp__img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) { .usp { grid-template-columns: 1fr; } .usp__img { aspect-ratio: 3 / 2; object-position: center 58%; } }
  @media (min-width: 521px) and (max-width: 1000px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .usp__body { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .usp__text { font-size: 19px; line-height: 1.55; max-width: 46ch; }
  .usp__proofs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; border-top: 1px solid rgba(32,33,36,.2); padding-top: 24px; }
  @media (max-width: 520px) { .usp__proofs { grid-template-columns: 1fr; } }
  .usp__proofs div { display: flex; flex-direction: column; gap: 6px; }
  .usp__icon { width: 32px; height: 32px; margin-bottom: 8px; fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: square; stroke-linejoin: miter; }
  .usp__proofs strong { font-weight: 500; font-size: 16px; line-height: 1.3; } .usp__proofs .lbl { font-size: 11px; line-height: 1.45; } .usp__proofs span:last-child { color: var(--text2); font-size: 15px; margin-top: 4px; }

  .method { padding-block: clamp(64px, 10vw, 120px); display: flex; flex-direction: column; gap: 56px; }
  .method__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .method__head .h2 { max-width: 20ch; margin-top: 16px; } .method__head > p { max-width: 36ch; }
  .method__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 16px; }
  .method__card { display: flex; flex-direction: column; gap: 16px; padding: 32px 28px 36px; background: var(--bone); text-decoration: none; min-height: 240px; }
  .method__card h3 { font-size: 24px; text-transform: uppercase; letter-spacing: .06em; } .method__n { font-size: 14px; color: var(--muted); }
  .method__sub { font-weight: 600; font-size: 15px; line-height: 1.4; color: var(--ink); }
  .method__get { font-size: 15px; border-top: 1px solid var(--line); padding-top: 14px; } .method__get .lbl { display: block; margin-bottom: 6px; }
  .method__go { margin-top: auto; font-size: 14px; font-weight: 500; }

  .feat { padding-block: clamp(64px, 10vw, 128px) 64px; display: flex; flex-direction: column; gap: 48px; }
  .feat__title { font-size: clamp(34px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -.02em; margin-top: 16px; }
  .feat__imgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .feat__imgs figure { margin: 0; display: flex; flex-direction: column; gap: 8px; } .feat__imgs img { aspect-ratio: 4 / 3; }
  .feat__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 40px; }
  .feat__cols div { border-top: 1px solid var(--ink); padding-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  .feat__fig { display: block; font-size: 28px; font-weight: 500; line-height: 1.1; }
  .feat__quote { margin: 0; border-top: 1px solid var(--line); padding-top: 40px; } .feat__quote p { font-size: clamp(22px, 2.4vw, 32px); max-width: 40ch; }

  .more { padding-block: 32px clamp(72px, 10vw, 120px); display: flex; flex-direction: column; gap: 40px; } .more > h2 { font-size: 36px; }
  .more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; }
  @media (max-width: 860px) { .more__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .more__grid { grid-template-columns: 1fr; } }
  .more__grid article { display: flex; flex-direction: column; gap: 12px; } .more__grid img { aspect-ratio: 4 / 5; } .more__grid .bw { filter: grayscale(1); } .more__grid h3 { font-size: 20px; line-height: 1.25; }

  .wip { padding-block: clamp(64px, 10vw, 112px); display: flex; flex-direction: column; gap: 48px; } .wip .h2 { max-width: 22ch; margin-top: 16px; }
  .wip__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 20px; }
  @media (max-width: 1100px) { .wip__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .wip__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .wip__grid { grid-template-columns: 1fr; } }
  .wip__card { display: grid; grid-template-rows: subgrid; grid-row: span 5; gap: 10px; align-content: start; }
  .wip__card > h3 { padding-top: 14px; } .wip__m2 { font-size: 17px; color: var(--bone); margin-top: -4px; }
  .wip__ph { background: #2c2d31; width: 100%; }
  .wip__img { aspect-ratio: 4 / 3; filter: grayscale(1) contrast(1.05); }
  .wip__card h3 { font-size: 21px; line-height: 1.25; text-wrap: balance; } .wip__card p { color: #c9c8bb; }

  .rev { padding-block: clamp(64px, 10vw, 120px); display: flex; flex-direction: column; gap: 48px; }
  .rev__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; } .rev__head h2 { font-size: clamp(28px, 6vw, 36px); margin-top: 16px; }
  .rev__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 24px; }
  .rev__grid figure { margin: 0; display: flex; flex-direction: column; gap: 20px; padding: 32px; background: var(--card); border: 1px solid rgba(32,33,36,.12); }
  .rev__stars { color: #b8963e; letter-spacing: .12em; font-size: 16px; }
  .rev__grid blockquote { margin: 0; font-size: 18px; } .rev__grid figcaption { margin-top: auto; font-size: 14px; color: var(--muted); }

  .team { padding-block: clamp(64px, 10vw, 112px); display: grid; grid-template-columns: 1fr 1.5fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .team { grid-template-columns: 1fr; } }
  .team__body { display: flex; flex-direction: column; gap: 24px; } .team__body > p:last-child { font-size: 18px; max-width: 44ch; }
  .team > img { aspect-ratio: 3 / 2; }
  .team__partners { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 24px; border-top: 1px solid rgba(32,33,36,.2); padding-top: 32px; }
  .team__p { display: flex; gap: 16px; align-items: center; } .team__p img { width: 72px; height: 72px; border-radius: 50%; flex: none; }
  .team__p div { display: flex; flex-direction: column; gap: 4px; } .team__p strong { font-weight: 500; font-size: 18px; } .team__p span { font-size: 14px; color: var(--text2); } .team__role { font-weight: 500; color: var(--ink) !important; }
  .team__more { font-weight: 500; text-decoration: underline; text-underline-offset: 4px; align-self: flex-start; padding-block: 10px; }
  .team__note { color: var(--muted) !important; font-size: 13px !important; }

