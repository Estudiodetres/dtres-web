---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContent } from '../data/i18n-content.js';
import { ui, routes, fmt as fmtL } from '../i18n/index.js';
import { srcset } from '../lib/img.js';
import { site } from '../data/content.js';

const { lang = 'es' } = Astro.props;
const { allProjects, statusLabels } = getContent(lang);
const t = ui[lang].projects;
const fmt = (n) => fmtL(n, lang);
const st = (s) => (s && statusLabels ? statusLabels[s] ?? s : s);
const filters = Object.entries(t.filters);
const total = allProjects.reduce((a, p) => a + (p.m2 || 0), 0);
const m2 = (p) => (p.m2 ? ` · ${fmt(p.m2)} m²` : '');
const listLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: t.title,
  itemListElement: allProjects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.use} · ${p.client}${m2(p)}` })),
};
---
<Base title={t.metaTitle} description={t.metaDesc(allProjects.length, fmt(Math.floor(total / 1000) * 1000))} jsonLd={[listLd]} lang={lang} alternates={routes.projects}>
  <section class="wrap pj-hero">
    <p class="lbl">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="pj-hero__sub">{t.sub}</p>
  </section>

  <section class="wrap pj">
    <div class="pj__filters" role="group" aria-label={t.filterLabel}>
      {filters.map(([k, l], i) => <button type="button" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
    </div>
    <div class="pj__wp" hidden>
      <div><strong>{t.wp.title}</strong><span>{t.wp.text}</span></div>
      <a class="btn" href={site.workplace}>{t.wp.cta} ↗</a>
    </div>
    <div class="pj__grid">
      {allProjects.map((p) => (
        <article data-cat={p.cat} data-heritage={p.heritage ? '1' : '0'} data-cambio={p.tag === 'Cambio de uso' ? '1' : '0'} data-curso={p.status ? '1' : '0'} class={p.img ? '' : 'noimg'}>
          {p.img
            ? <img class={p.bw ? "ph bw" : "ph"} src={p.img} srcset={srcset(p.img)} sizes="(min-width: 860px) 33vw, 50vw" alt={`${p.use} · ${p.client}`} width="600" height="750" loading="lazy" />
            : <div class="pj__ph"><span>{st(p.status) ?? t.project}</span>{p.m2 && <strong>{fmt(p.m2)} m²</strong>}</div>}
          <h2>{p.use}{m2(p)}</h2>
          <p>{p.client}</p>
          {(p.heritage || p.tag || (p.img && p.status)) && <span class="lbl">{[p.img && st(p.status), p.tag && st(p.tag), p.heritage && t.heritage].filter(Boolean).join(' · ')}</span>}
        </article>
      ))}
    </div>
  </section>

  <section id="contacto" class="dark">
    <div class="wrap pj-cta">
      <h2>{ui[lang].home.ctaTitle}</h2>
      <ContactForm origen="proyectos" lang={lang} />
    </div>
  </section>
</Base>
<script>
  const btns = document.querySelectorAll('.pj__filters button');
  const items = document.querySelectorAll('.pj__grid article');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((it) => {
      const show = f === 'todos' || (f === 'curso' ? it.dataset.curso === '1' : f === 'patrimonio' ? it.dataset.heritage === '1' : f === 'cambio' ? it.dataset.cambio === '1' : it.dataset.cat === f);
      it.hidden = !show;
    });
    const wp = document.querySelector('.pj__wp');
    if (wp) wp.hidden = f !== 'oficinas';
  }));
</script>
<style>
  .pj-hero { padding-block: clamp(48px, 8vw, 96px) 56px; display: flex; flex-direction: column; gap: 24px; }
  .pj-hero h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 16ch; text-wrap: balance; }
  .pj-hero__sub { font-size: 21px; line-height: 1.45; max-width: 52ch; }
  .pj { padding-block: 0 clamp(72px, 10vw, 120px); display: flex; flex-direction: column; gap: 40px; }
  .pj__grid [data-curso="1"] .ph, .pj__grid .bw { filter: grayscale(1); }
  .pj__wp { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 22px; margin-top: 24px; }
  .pj__wp div { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pj__wp strong { font-weight: 500; font-size: 20px; }
  .pj__wp span { color: var(--text2); font-size: 15px; }
  .pj__filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .pj__filters button { font: inherit; font-size: 14px; padding: 10px 16px; border: 1px solid var(--line); background: transparent; color: inherit; cursor: pointer; }
  .pj__filters button[aria-pressed="true"] { background: #202124; color: #eaeae4; border-color: #202124; }
  .pj__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px 24px; }
  @media (max-width: 860px) { .pj__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .pj__grid { gap: 36px 12px; } .pj__grid h2 { font-size: 17px; } .pj__grid p { font-size: 14px; } .pj__ph { padding: 16px; } .pj__ph strong { font-size: 28px; } }
  .pj__grid article { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .pj__grid img, .pj__ph { aspect-ratio: 4 / 5; width: 100%; }
  .pj__ph { background: #dcdbd2; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; }
  .pj__ph span { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #6b6b60; }
  .pj__ph strong { font-size: clamp(36px, 4vw, 56px); font-weight: 400; letter-spacing: -.02em; color: #202124; }
  .pj__grid h2 { font-size: 22px; font-weight: 500; line-height: 1.2; }
  .pj__grid p { color: var(--text2); }
  .pj-cta { padding-block: clamp(64px, 10vw, 112px); display: flex; flex-direction: column; gap: 32px; } .pj-cta h2 { font-size: clamp(32px, 4vw, 56px); }
</style>
