---
const { origen = 'home' } = Astro.props;
---
<form class="cf" method="post" name="contacto-workplace" action="/gracias/" data-netlify="true" netlify-honeypot="website">
  <input type="hidden" name="form-name" value="contacto-workplace" />
  <input type="hidden" name="origen" value={`workplace-${origen}`} />
  <label class="cf__hp" aria-hidden="true">No rellenar <input name="website" tabindex="-1" autocomplete="off" /></label>
  <div class="cf__grid">
    <label>Nombre<input name="nombre" required autocomplete="name" /></label>
    <label>Email<input name="email" type="email" required autocomplete="email" /></label>
    <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" /></label>
    <label>Empresa<input name="empresa" autocomplete="organization" /></label>
    <label>Personas en el equipo
      <select name="personas"><option>Menos de 20</option><option>20 – 50</option><option>50 – 100</option><option>Más de 100</option></select>
    </label>
    <label>¿Tenéis ya local?
      <select name="local"><option>Buscamos local</option><option>Ya tenemos local</option><option>Queremos reformar el actual</option></select>
    </label>
    <label class="cf__full">Cuéntanos qué necesitáis<textarea name="mensaje" rows="4"></textarea></label>
  </div>
  <p class="cf__legal">Usaremos tus datos solo para responderte. <a href="https://detres.eu/privacidad/">Política de privacidad</a>.</p>
  <button class="btn btn--light" type="submit">Pedir consultoría gratuita</button>
</form>
<style>
  .cf { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 760px; }
  .cf__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px; }
  .cf label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: #c9c8bb; }
  .cf__full { grid-column: 1 / -1; }
  .cf input, .cf select, .cf textarea { font: inherit; color: var(--bone); background: transparent; border: 1px solid rgba(234,234,228,.35); padding: 12px 14px; min-height: 48px; }
  .cf select option { color: var(--ink); }
  .cf__legal { font-size: 13px; color: #c9c8bb; }
  .cf__legal a { color: inherit; }
  .cf__hp { position: absolute; left: -9999px; }
  .cf button { align-self: flex-start; border: 0; cursor: pointer; font: inherit; font-weight: 500; }
  @media (max-width: 520px) { .cf button { align-self: stretch; justify-content: center; } }
</style>
