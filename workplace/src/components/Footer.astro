---
import { site } from '../data/content.js';
---
<footer class="ftr dark">
  <div class="wrap ftr__in">
    <div class="ftr__col"><span class="ftr__logo">DTRES Workplace</span><span>Diseño y construcción de oficinas para empresas en crecimiento en Barcelona.</span><a class="ftr__parent" href={site.parent}>Parte de DTRES Arquitectura ↗</a></div>
    <div class="ftr__col"><span class="lbl">Estudio</span><span>{site.address.street}</span><span>{site.address.postalCode} {site.address.city}</span></div>
    <div class="ftr__col"><span class="lbl">Contacto</span><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phoneDisplay}</a><a href={site.linkedin}>LinkedIn</a><a href={site.instagram}>Instagram</a></div>
    <div class="ftr__col"><span class="lbl">Legal</span><a href={`${site.parent}/aviso-legal/`}>Aviso legal</a><a href={`${site.parent}/privacidad/`}>Privacidad</a><a href={`${site.parent}/cookies/`}>Cookies</a></div>
  </div>
  <div class="wrap ftr__base"><span>© {new Date().getFullYear()} {site.legalName}</span></div>
</footer>
<style>
  .ftr { color: #c9c8bb; }
  .ftr__in { padding-block: 56px 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 32px; font-size: 15px; }
  .ftr__col { display: flex; flex-direction: column; gap: 6px; }
  .ftr__col a { color: #c9c8bb; text-decoration: none; }
  .ftr__logo { font-size: 22px; font-weight: 600; letter-spacing: .04em; color: var(--bone); }
  .ftr__parent { margin-top: 10px; color: var(--bone) !important; text-decoration: underline !important; text-underline-offset: 4px; }
  .ftr__base { padding-block: 0 40px; font-size: 13px; color: #8f8e82; }
</style>
