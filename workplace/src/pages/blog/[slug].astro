---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/content.js';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await post.render();
const df = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });
const ld = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, datePublished: d.date.toISOString(), inLanguage: 'es', keywords: d.keyword,
    author: { '@type': 'Person', name: d.author }, publisher: { '@id': `${site.url}/#org` }, mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://workplace.detres.eu/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://workplace.detres.eu/blog/' },
    { '@type': 'ListItem', position: 3, name: d.title }] },
];
const title = d.seoTitle || d.title;
---
<Base title={title.length > 52 ? title : `${title} · DTRES Workplace`} description={d.description} jsonLd={ld}>
  <article class="wrap po">
    <header class="po__head">
      <a class="po__back" href="/blog/">← Blog</a>
      <p class="lbl">{[d.tag, df.format(d.date)].filter(Boolean).join(' · ')}</p>
      <h1>{d.title}</h1>
      <p class="po__lead">{d.description}</p>
      <p class="po__by">Por {d.author}</p>
    </header>
    <div class="po__body"><Content /></div>
  </article>
  <section id="contacto" class="dark">
    <div class="wrap po-cta">
      <h2>¿Cambias de oficina? Hablemos.</h2>
      <ContactForm origen={`blog-${post.slug}`} />
    </div>
  </section>
</Base>
<style>
  .po { padding-block: clamp(48px, 8vw, 72px) 112px; display: flex; flex-direction: column; gap: 48px; }
  .po__head { display: flex; flex-direction: column; gap: 20px; max-width: 900px; }
  .po__back { font-size: 15px; text-decoration: none; color: var(--muted); padding-block: 10px; align-self: flex-start; }
  .po h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1.04; letter-spacing: -.02em; text-wrap: balance; }
  .po__lead { font-size: 21px; line-height: 1.45; max-width: 52ch; color: var(--text2); }
  .po__by { font-size: 14px; color: var(--muted); }
  .po__body { max-width: 68ch; font-size: 18px; line-height: 1.65; display: flex; flex-direction: column; gap: 18px; }
  .po__body :global(h2) { font-size: 28px; line-height: 1.2; margin-top: 24px; }
  .po__body :global(h3) { font-size: 21px; margin-top: 12px; }
  .po__body :global(p) { margin: 0; }
  .po__body :global(ul), .po__body :global(ol) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }
  .po__body :global(blockquote) { margin: 0; border-left: 2px solid var(--sage, #8a9a7b); padding-left: 20px; color: var(--text2); }
  .po-cta { padding-block: clamp(64px, 10vw, 112px); display: flex; flex-direction: column; gap: 32px; } .po-cta h2 { font-size: clamp(32px, 4vw, 56px); }
</style>
