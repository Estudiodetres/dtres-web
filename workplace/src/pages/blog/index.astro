---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date);
const df = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });
const ld = { '@context': 'https://schema.org', '@type': 'Blog', name: 'Blog · DTRES Workplace', inLanguage: 'es',
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: new URL(`/blog/${p.slug}/`, Astro.site).href, datePublished: p.data.date.toISOString() })) };
---
<Base title="Blog · Diseño y obra de oficinas en Barcelona · DTRES Workplace" description="Guías para empresas que cambian de oficina en Barcelona: local, distribución, licencias, costes y plazos, explicados por los arquitectos de DTRES." jsonLd={[ld]}>
  <section class="wrap bl-hero">
    <p class="lbl">Blog · Guías de oficinas</p>
    <h1>Lo que hay que saber antes de cambiar de oficina.</h1>
    <p class="bl-hero__sub">Local, distribución, licencias, costes y plazos en Barcelona, explicados por el equipo que diseña y construye oficinas cada semana.</p>
  </section>
  <section class="wrap bl">
    {posts.map((p) => (
      <a class="bl__item" href={`/blog/${p.slug}/`}>
        <span class="lbl">{[p.data.tag, df.format(p.data.date)].filter(Boolean).join(' · ')}</span>
        <h2>{p.data.title}</h2>
        <p>{p.data.description}</p>
        <span class="bl__go">Leer →</span>
      </a>
    ))}
  </section>
</Base>
<style>
  .bl-hero { padding-block: clamp(48px, 8vw, 96px) 56px; display: flex; flex-direction: column; gap: 24px; }
  .bl-hero h1 { font-size: clamp(40px, 6vw, 84px); line-height: 1; letter-spacing: -.02em; max-width: 18ch; }
  .bl-hero__sub { font-size: 21px; line-height: 1.45; max-width: 52ch; }
  .bl { padding-block: 0 clamp(72px, 10vw, 120px); display: flex; flex-direction: column; }
  .bl__item { text-decoration: none; border-top: 1px solid var(--line); padding-block: 32px; display: grid; grid-template-columns: 1fr 2fr auto; gap: 8px 32px; align-items: baseline; }
  .bl__item:last-child { border-bottom: 1px solid var(--line); }
  .bl__item h2 { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2; grid-column: 2; }
  .bl__item p { color: var(--text2); grid-column: 2; max-width: 60ch; }
  .bl__item .lbl { grid-column: 1; grid-row: 1; }
  .bl__go { grid-column: 3; grid-row: 1; font-size: 15px; }
  .bl__item:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) { .bl__item { grid-template-columns: 1fr; } .bl__item h2, .bl__item p, .bl__item .lbl, .bl__go { grid-column: 1; grid-row: auto; } }
</style>
