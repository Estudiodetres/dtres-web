---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/content.js';
import { srcset } from '../../lib/img.js';
import galleries from '../../data/galleries.json';
const CDN = 'https://detres.eu';
export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] } }));
}
const { p, prev, next } = Astro.props;
const gal = galleries[p.slug] || [];
const gset = (src) => `${CDN}${src.replace('.jpg', '-w640.webp')} 640w, ${CDN}${src.replace('.jpg', '-w1200.webp')} 1200w`;
const ld = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: `${p.name} · DTRES Workplace`, about: p.title, creator: { '@id': 'https://workplace.detres.eu/#org' }, ...(p.img ? { image: new URL(p.img, Astro.site).href } : {}) };
---
<Base title={`${p.name} · Casos de éxito · DTRES Workplace`} description={p.desc ?? `${p.title}. ${p.meta}. Oficina diseñada y construida por DTRES en Barcelona.`} jsonLd={[ld, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://workplace.detres.eu/' }, { '@type': 'ListItem', position: 2, name: 'Casos de éxito', item: 'https://workplace.detres.eu/casosdeexito/' }, { '@type': 'ListItem', position: 3, name: p.name }] }]}>
  <section class="wrap cs-hero">
    <a class="lbl" href="/casosdeexito/">← Casos de éxito</a>
    <h1>{p.name}</h1>
    <p class="cs-sub">{p.title}</p>
    <p class="lbl">{p.meta}</p>
  </section>
  {p.key && (
    <section class="wrap cs-ba">
      <figure><img class="ph" src={`/img/wpc-${p.key}-antes.jpg`} srcset={srcset(`/img/wpc-${p.key}-antes.jpg`)} sizes="(min-width: 760px) 50vw, 100vw" alt={`${p.name} antes`} width="600" height="750" /><figcaption class="lbl">Antes</figcaption></figure>
      <figure><img class="ph" src={`/img/wpc-${p.key}-despues.jpg`} srcset={srcset(`/img/wpc-${p.key}-despues.jpg`)} sizes="(min-width: 760px) 50vw, 100vw" alt={`${p.name} después`} width="600" height="750" /><figcaption class="lbl">Después</figcaption></figure>
    </section>
  )}
  {p.img && <section class="wrap" style="margin-top: 24px"><img class="ph cs-img" src={p.img} srcset={srcset(p.img)} sizes="100vw" alt={`Oficina ${p.name} diseñada por DTRES`} width="2000" height="1300" /></section>}
  {gal.length > 0 && (
    <section class="wrap cs-gal">
      <p class="lbl">Galería del proceso · {gal.length} fotos</p>
      <div class="cs-gal__grid">
        {gal.map((g, k) => <a href={`${CDN}${g.src.replace('.jpg', '-w1200.webp')}`} target="_blank" rel="noopener"><img class="ph" src={`${CDN}${g.src}`} srcset={gset(g.src)} sizes="(min-width: 1100px) 33vw, (min-width: 600px) 50vw, 100vw" alt={`${p.name} · ${k + 1}`} width={g.w} height={g.h} loading="lazy" decoding="async" /></a>)}
      </div>
    </section>
  )}
  <nav class="wrap cs-nav">
    <a href={`/casosdeexito/${prev.slug}/`}>← {prev.name}</a>
    <a href="/contacto/" class="btn">Quiero una oficina así</a>
    <a href={`/casosdeexito/${next.slug}/`}>{next.name} →</a>
  </nav>
</Base>
<style>
  .cs-hero { padding-block: clamp(48px, 7vw, 88px) 40px; display: flex; flex-direction: column; gap: 18px; }
  .cs-hero a.lbl { text-decoration: none; }
  .cs-hero h1 { font-size: clamp(40px, 6vw, 84px); line-height: 1; letter-spacing: -.02em; }
  .cs-sub { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.4; max-width: 46ch; color: var(--text2); }
  .cs-ba { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .cs-ba figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .cs-ba img { aspect-ratio: 4 / 5; }
  @media (max-width: 520px) { .cs-ba { gap: 8px; } }
  .cs-img { aspect-ratio: 16 / 10; }
  .cs-gal { padding-top: 48px; display: flex; flex-direction: column; gap: 20px; }
  .cs-gal__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .cs-gal__grid a { display: block; }
  .cs-gal__grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .cs-nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 48px clamp(64px, 9vw, 120px); }
  .cs-nav > a:not(.btn) { text-underline-offset: 4px; }
</style>
