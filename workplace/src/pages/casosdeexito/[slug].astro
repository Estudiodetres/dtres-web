---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/content.js';
import { srcset } from '../../lib/img.js';
import galleries from '../../data/galleries.json';
const CDN = 'https://detres.eu';
export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] } }));
}
const { p, prev, next } = Astro.props;
const gal = galleries[p.slug] || [];
const gset = (src) => `${CDN}${src.replace('.jpg', '-w640.webp')} 640w, ${CDN}${src.replace('.jpg', '-w1200.webp')} 1200w`;
const ld = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: `${p.name} · DTRES Workplace`, about: p.title, creator: { '@id': 'https://workplace.detres.eu/#org' }, ...(p.img ? { image: new URL(p.img, Astro.site).href } : {}) };
const stageOrder = ['antes', 'durante', 'despues'];
const stageLabels = { antes: ['Antes', 'El espacio tal como lo encontramos.'], durante: ['Durante la obra', 'Demolición, instalaciones y construcción.'], despues: ['Después', 'El resultado entregado.'] };
---
<Base title={`${p.name} · Casos de éxito · DTRES Workplace`} description={p.desc ?? `${p.title}. ${p.meta}. Oficina diseñada y construida por DTRES en Barcelona.`} jsonLd={[ld, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://workplace.detres.eu/' }, { '@type': 'ListItem', position: 2, name: 'Casos de éxito', item: 'https://workplace.detres.eu/casosdeexito/' }, { '@type': 'ListItem', position: 3, name: p.name }] }]}>
  <section class="wrap cs-hero">
    <a class="lbl" href="/casosdeexito/">← Casos de éxito</a>
    <h1>{p.name}</h1>
    <p class="cs-sub">{p.title}</p>
    <p class="lbl">{p.meta}</p>
  </section>
  {p.key && (
    <section class="wrap cs-ba">
      <figure><img class="ph" src={`/img/wpc-${p.key}-antes.jpg`} srcset={srcset(`/img/wpc-${p.key}-antes.jpg`)} sizes="(min-width: 760px) 50vw, calc(100vw - 48px)" alt={`${p.name} antes`} width="600" height="750" /><figcaption class="lbl">Antes</figcaption></figure>
      <figure><img class="ph" src={`/img/wpc-${p.key}-despues.jpg`} srcset={srcset(`/img/wpc-${p.key}-despues.jpg`)} sizes="(min-width: 760px) 50vw, calc(100vw - 48px)" alt={`${p.name} después`} width="600" height="750" /><figcaption class="lbl">Después</figcaption></figure>
    </section>
  )}
  {p.img && <section class="wrap" style="margin-top: 24px"><img class="ph cs-img" src={p.img} srcset={srcset(p.img)} sizes="(min-width: 1680px) 1520px, (min-width: 1280px) 1232px, calc(100vw - 48px)" alt={`Oficina ${p.name} diseñada por DTRES`} width="2000" height="1300" /></section>}
  {gal.length > 0 && (
    <section class="wrap cs-gal">
      {stageOrder.filter((s) => gal.some((g) => g.stage === s)).map((s, n) => { const st = stageLabels[s]; const list = gal.filter((g) => g.stage === s); return (
        <div class="cs-gal__stage">
          <header class="cs-gal__head"><span class="cs-gal__n">{String(n + 1).padStart(2, '0')}</span><h2>{st[0]}</h2><p>{st[1]} <span class="lbl">{list.length} fotos</span></p></header>
          <div class="cs-gal__grid">
            {list.map((g, k) => <a href={`${CDN}${g.src.replace('.jpg', '-w1200.webp')}`} target="_blank" rel="noopener"><img class="ph" src={`${CDN}${g.src}`} srcset={gset(g.src)} sizes="(min-width: 1100px) 33vw, (min-width: 600px) 50vw, calc(100vw - 48px)" alt={`${p.name} · ${st[0]} ${k + 1}`} width={g.w} height={g.h} loading="lazy" decoding="async" /><span class="cs-gal__tag">{st[0]}</span></a>)}
          </div>
        </div>
      ); })}
    </section>
  )}
  <nav class="wrap cs-nav">
    <a href={`/casosdeexito/${prev.slug}/`}>← {prev.name}</a>
    <a href="/contacto/" class="btn">Quiero una oficina así</a>
    <a href={`/casosdeexito/${next.slug}/`}>{next.name} →</a>
  </nav>
</Base>
<style>
  .cs-hero { padding-block: clamp(48px, 7vw, 88px) 40px; display: flex; flex-direction: column; gap: 18px; }
  .cs-hero a.lbl { text-decoration: none; }
  .cs-hero h1 { font-size: clamp(40px, 6vw, 84px); line-height: 1; letter-spacing: -.02em; }
  .cs-sub { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.4; max-width: 46ch; color: var(--text2); }
  .cs-ba { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .cs-ba figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .cs-ba img { aspect-ratio: 4 / 5; }
  @media (max-width: 520px) { .cs-ba { gap: 8px; } }
  .cs-img { aspect-ratio: 16 / 10; }
  .cs-gal { padding-top: 48px; display: flex; flex-direction: column; gap: 56px; }
  .cs-gal__stage { display: flex; flex-direction: column; gap: 20px; }
  .cs-gal__head { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; align-items: baseline; border-top: 1px solid var(--line, rgba(32,33,36,.15)); padding-top: 20px; }
  .cs-gal__n { font-size: 14px; letter-spacing: .08em; color: var(--muted); grid-row: span 2; }
  .cs-gal__head h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.1; margin: 0; }
  .cs-gal__head p { margin: 4px 0 0; color: var(--muted); display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; }
  .cs-gal__grid a { position: relative; }
  .cs-gal__tag { position: absolute; left: 10px; bottom: 10px; padding: 4px 10px; border-radius: 999px; background: rgba(234,234,228,.92); color: #202124; font-size: 12px; pointer-events: none; }
  .cs-gal__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .cs-gal__grid a { display: block; }
  .cs-gal__grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .cs-nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 48px clamp(64px, 9vw, 120px); }
  .cs-nav > a:not(.btn) { text-underline-offset: 4px; }
</style>
